{
 "_doc": "Single source of truth for the design tokens. `npm run tokens` writes src/tokens.generated.css from this file; native apps read the same file. Type: Satoshi for UI (dense cricket stats lh/ls); Barlow Condensed for scoreboard figures via --font-condensed in index.css.",
 "color": {
  "background": "#0C0C0E",
  "foreground": "#ffffff",
  "card": "#1c1c1e",
  "card-foreground": "#ffffff",
  "popover": "#2c2c2e",
  "popover-foreground": "#ffffff",
  "primary": "#27da8e",
  "primary-foreground": "#0f0f0f",
  "secondary": "#2c2c2e",
  "secondary-foreground": "#ffffff",
  "muted": "#1c1c1e",
  "muted-foreground": "#98989d",
  "accent": "#3a3a3c",
  "accent-foreground": "#ffffff",
  "destructive": "#ff4444",
  "border": "#2c2c2e",
  "input": "#1c1c1e",
  "ring": "#27da8e",
  "sidebar": "#0C0C0E",
  "sidebar-foreground": "#ffffff",
  "sidebar-primary": "#27da8e",
  "sidebar-primary-foreground": "#0f0f0f",
  "sidebar-accent": "#1c1c1e",
  "sidebar-accent-foreground": "#ffffff",
  "sidebar-border": "#1c1c1e",
  "sidebar-ring": "#27da8e",
  "hit": "#27da8e",
  "miss": "#ff0000",
  "dnp": "#999999",
  "amber": "#f5a524",
  "pill": "#2c2c2e",
  "hairline": "rgba(255, 255, 255, 0.10)",
  "surface": "rgba(255, 255, 255, 0.03)",
  "surface-hover": "rgba(255, 255, 255, 0.06)",
  "scrim": "rgba(0, 0, 0, 0.40)",
  "body-size": "14px",
  "surface-raised": "rgba(255, 255, 255, 0.08)",
  "focus-ring": "#27da8e",
  "chrome-solid": "rgba(12, 12, 14, 0.97)",
  "control-fill": "rgba(255, 255, 255, 0.10)",
  "control-ring": "rgba(255, 255, 255, 0.14)",
  "tile": "rgba(44, 44, 46, 0.6)",
  "segment-track": "rgba(44, 44, 46, 0.7)",
  "segment-thumb": "#58585c",
  "ink-soft": "rgba(15, 15, 15, 0.65)",
  "skeleton": "rgba(255, 255, 255, 0.12)",
  "text-soft": "rgba(255, 255, 255, 0.7)"
 },
 "size": {
  "radius": "0.75rem",
  "card-radius": "1rem",
  "header-h": "3.5rem",
  "tabbar-h": "3.0625rem",
  "tabbar-pad": "0rem",
  "control": "2.25rem",
  "chip-radius": "999px",
  "row-min": "3.5rem",
  "fixture-card": "80vw",
  "gutter": "0.875rem",
  "content-max": "100%",
  "touch": "2.75rem",
  "fab": "3.5rem",
  "sheet-radius": "1.5rem"
 },
 "type": {
  "fs-display": "clamp(1.5rem, 1.35rem + 0.6vw, 1.75rem)",
  "fs-display-lh": "1.1",
  "fs-display-ls": "-0.025em",
  "fs-title": "1.125rem",
  "fs-title-lh": "1.2",
  "fs-title-ls": "-0.02em",
  "fs-body": "0.9375rem",
  "fs-body-lh": "1.25",
  "fs-body-ls": "-0.01em",
  "fs-callout": "0.8125rem",
  "fs-callout-lh": "1.3",
  "fs-callout-ls": "-0.005em",
  "fs-footnote": "0.75rem",
  "fs-footnote-lh": "1.25",
  "fs-caption": "0.625rem",
  "fs-caption-lh": "1.25",
  "fs-caption-ls": "0.01em",
  "fs-metric": "1.25rem",
  "fs-metric-lh": "1",
  "fs-metric-ls": "-0.02em",
  "fs-stat": "1.875rem",
  "fs-stat-lh": "1",
  "fs-stat-ls": "-0.03em",
  "fs-figure": "1.5rem",
  "fs-figure-lh": "1",
  "fs-figure-ls": "-0.02em"
 },
 "space": {
  "space-hair": "0.25rem",
  "space-tight": "0.375rem",
  "space-snug": "0.625rem",
  "space-stack": "1rem",
  "space-group": "1.25rem",
  "space-section": "2rem",
  "space-inset": "0.875rem"
 },
 "weight": {
  "weight-editorial": 300,
  "weight-copy": 400,
  "weight-label": 500,
  "weight-emphasis": 700,
  "weight-brand": 900
 },
 "font": {
  "font-sans-stack": "\"Satoshi\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif"
 },
 "other": {
  "ion-background-color": "var(--background)",
  "ion-text-color": "var(--foreground)"
 },
 "motion": {
  "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
  "ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
  "ease-drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
  "duration-instant": "80ms",
  "duration-fast": "150ms",
  "duration-base": "220ms",
  "duration-moderate": "300ms",
  "duration-flash": "450ms",
  "duration-slow": "500ms"
 },
 "chart": {
  "chart-hit": "var(--hit)",
  "chart-miss": "var(--miss)",
  "chart-push": "var(--amber)",
  "chart-dnp": "var(--dnp)",
  "chart-line": "#ffffff",
  "chart-grid": "var(--hairline)",
  "chart-spark-min": "0.125rem"
 },
 "elevation": {
  "sheet": "0 -8px 32px rgba(0, 0, 0, 0.55)",
  "raised": "0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 24px rgba(0, 0, 0, 0.35)",
  "fab": "0 6px 20px rgba(39, 218, 142, 0.35)"
 },
 "breakpoint": {
  "sm": "640px",
  "md": "768px",
  "lg": "1024px",
  "xl": "1440px"
 },
 "platform": {
  "_doc": "Per-platform conventions, read by mobile/src/ui/platform.ts and the design-system page; not emitted as CSS. Touch targets follow each guide (iOS HIG 44 pt, Material 48 dp, web 44 px comfortable). Font scale caps: the OS font-size setting is honoured up to this multiple so dense stat tables keep fitting.",
  "touch-ios": "2.75rem",
  "touch-android": "3rem",
  "touch-web": "2.75rem",
  "press-scale": 0.97,
  "press-ms": 120,
  "font-scale-max-ios": 1.3,
  "font-scale-max-android": 1.2,
  "font-scale-max-web": 1.5
 },
 "rhythm": {
  "_doc": "The vertical rhythm every page follows, by space role (not emitted as CSS): within = rows inside one group, between = blocks on a page, section = major sections, top = under the header, inline = page side inset. Web classes gap-snug / gap-stack / gap-section / pt-stack / px-gutter; app `rhythm` in ui/tokens.ts.",
  "within": "space-snug",
  "between": "space-stack",
  "section": "space-section",
  "top": "space-stack",
  "inline": "gutter"
 },
 "spring": {
  "_doc": "Spring presets (not emitted as CSS): web motion/react stiffness+damping, app Reanimated duration+dampingRatio. settle = an indicator gliding to its target; roll = a figure rolling in; enter = a card rising into place.",
  "settle": {
   "duration": 350,
   "dampingRatio": 0.85,
   "stiffness": 500,
   "damping": 38
  },
  "roll": {
   "duration": 420,
   "dampingRatio": 0.8
  },
  "enter": {
   "duration": 420,
   "dampingRatio": 0.9
  }
 },
 "grid": {
  "_doc": "Column grid (not emitted as CSS; read by packages/tokens/grid.js, the app's useGrid and the CardGrid test). Compact (phone, < md) 4 columns, md 8, xl 12 (lg keeps 8: the sidebar takes the width). Page margin = --gutter (14 / 20 / 24). A card spans `card-span` columns, so 1 / 2 / 3 cards per row.",
  "columns-compact": 4,
  "columns-md": 8,
  "columns-xl": 12,
  "gutter": "1rem",
  "card-span": 4
 },
 "elevation_native": {
  "_doc": "App shadows (iOS shadow props, Android elevation); the web twins are the --shadow-* values in `elevation`. raised = a lifted control or thumb, sheet = a panel over a scrim, fab = a floating action.",
  "raised": {
   "opacity": 0.35,
   "radius": 8,
   "offsetY": 2,
   "elevation": 3
  },
  "sheet": {
   "opacity": 0.55,
   "radius": 24,
   "offsetY": -8,
   "elevation": 16
  },
  "fab": {
   "opacity": 0.35,
   "radius": 20,
   "offsetY": 6,
   "elevation": 8
  },
  "thumb": {
   "opacity": 0.3,
   "radius": 3,
   "offsetY": 1,
   "elevation": 1
  }
 },
 "state": {
  "_doc": "Interaction state opacities (CSS: --pressed-opacity ...; app: `state` in ui/tokens.ts): pressed = a control under the finger, disabled = a control that cannot act, dim = content that is out of play (a void line, a team that is out).",
  "pressed-opacity": 0.7,
  "disabled-opacity": 0.55,
  "dim-opacity": 0.6
 },
 "icon": {
  "_doc": "Icon sizes (not emitted as CSS): xs 12 (size-3), sm 16 (size-4: inline with text), md 20 (size-5: buttons, headers, rows), lg 24 (size-6: back, hero). Web uses the matching Tailwind size-* classes; the app `icon.*` in ui/tokens.ts.",
  "xs": "0.75rem",
  "sm": "1rem",
  "md": "1.25rem",
  "lg": "1.5rem"
 }
}
