{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "/api/share?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 20
    },
    "api/live.js": {
      "maxDuration": 20,
      "includeFiles": "public/data/identity.json"
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "{public/data/*.json,node_modules/@fontsource/barlow-condensed/files/*.woff}"
    },
    "api/share.js": {
      "maxDuration": 10,
      "includeFiles": "public/data/*.json"
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "npm ci"
}
