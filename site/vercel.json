{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "/api/share?path=:path*"
    },
    {
      "source": "/card/:path*",
      "destination": "/api/og?path=:path*"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/gate.js": {
      "maxDuration": 5
    },
    "api/geo.js": {
      "maxDuration": 5
    },
    "api/live.js": {
      "maxDuration": 20,
      "includeFiles": "public/data/identity.json"
    },
    "api/og.js": {
      "maxDuration": 15,
      "includeFiles": "{public/data/index.json,public/data/photos.json,public/data/lines.json,public/data/fixtures.json,public/books/*,public/icon-192.png,fonts/satoshi/*.woff,node_modules/@fontsource/barlow-condensed/files/barlow-condensed-latin-*-normal.woff}"
    },
    "api/share.js": {
      "maxDuration": 10,
      "includeFiles": "{public/data/index.json,public/data/photos.json,public/data/lines.json,public/data/fixtures.json}"
    },
    "api/state.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/data/meta.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=120"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "npm ci"
}
