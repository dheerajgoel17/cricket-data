{
  "name": "cricket-props-fallback",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "NODE_ENV": "production" },
  "durable_objects": {
    "bindings": [{ "name": "SNAPSHOTS", "class_name": "Snapshots" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Snapshots"] }],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/*", "/card/*", "/share/*"]
  },
  "observability": { "enabled": true }
}
