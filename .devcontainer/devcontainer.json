{
  "name": "Cricket Data",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "alexcvzz.vscode-sqlite", "mechatroner.rainbow-csv"],
      "settings": { "python.testing.pytestArgs": ["tests"], "python.testing.pytestEnabled": true }
    }
  }
}
